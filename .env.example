# Copy to .env for local development (with docker-compose.dev.yml).

MAP_DASHBOARD_API_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
CORS_ORIGINS=http://localhost:3000

# Required on the server for production deploy (written by GitHub Actions):
# CADDY_DOCKER_NETWORK=reverse_proxy
# CORS_ORIGINS=https://map.example.com

# Optional rate-limit tuning (Next.js server)
# RATE_LIMIT_MAP_POINTS_MAX=30
# RATE_LIMIT_MAP_POINTS_WINDOW_MS=60000

# Ingest scripts (not required for map dashboard)
# GOOGLE_MAPS_API_KEY=
# MONGODB_URI=mongodb://localhost:27017/inpost_assignment
