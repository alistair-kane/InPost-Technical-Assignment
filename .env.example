# Google Maps Platform: enable Places API (Nearby Search + Place Details) for ingest scripts.
# For the dashboard map layer, enable Maps JavaScript API and restrict HTTP referrers to your origins.
GOOGLE_MAPS_API_KEY=

# Browser-exposed Maps key for Next.js (`apps/web`).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Vector Map ID (Google Cloud Console > Google Maps Platform > Map Management).
# Required for AdvancedMarkerElement clustering (replacing deprecated google.maps.Marker).
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Single shared secret: FastAPI `GET /points` requires header `X-Api-Key: <secret>`.
# Next.js proxies via `GET /api/map-points` using this value server-side only (never `NEXT_PUBLIC_`).
MAP_DASHBOARD_API_SECRET=

# Optional default country for InPost Global Points lookups (`GET /api/inpost-point`). Falls back to PL.
INPOST_POINTS_COUNTRY=PL

# Default matches docker-compose MongoDB without auth on localhost (ingest scripts on host).
MONGODB_URI=mongodb://localhost:27017/inpost_assignment

# Comma-separated browser origins allowed to call the FastAPI app directly (e.g. local Next dev hitting API).
# Align with production HTTPS origins and Google Maps referrer allowlists after deploy.
CORS_ORIGINS=http://localhost:3000
